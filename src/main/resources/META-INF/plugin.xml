<idea-plugin>
    <id>dev.diffdino.pairing</id>
    <name>DiffDino Pairing</name>
    <vendor>DiffDino</vendor>
    <description><![CDATA[
    Pair programming with an AI agent over the Agent Client Protocol: the agent navigates, you write.
    Chat with approvals, pairing sessions with stops, and agent drafts shown in the editor to accept.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.DiffDinoBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="DiffDino Agent" anchor="right" icon="AllIcons.Toolwindows.ToolWindowMessages"
                    factoryClass="dev.diffdino.pairing.ui.AgentToolWindowFactory"/>
        <applicationService serviceImplementation="dev.diffdino.pairing.settings.AgentSettings"/>
        <applicationService serviceImplementation="dev.diffdino.pairing.mcp.AgentToolServer"/>
        <projectService serviceImplementation="dev.diffdino.pairing.pairing.PairingProjectService"/>
        <postStartupActivity implementation="dev.diffdino.pairing.ui.ToolWindowVisibility"/>
        <applicationConfigurable parentId="tools" id="dev.diffdino.pairing.settings.agents"
                                 instance="dev.diffdino.pairing.ui.settings.AgentPresetsConfigurable"
                                 displayName="DiffDino"/>
    </extensions>

    <!-- Editor: drafts and spotlights drawn in the project's editors -->
    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceInterface="dev.diffdino.pairing.model.PairingPresentation"
                        serviceImplementation="dev.diffdino.pairing.editor.EditorPairingPresentation"/>
        <projectService serviceInterface="dev.diffdino.pairing.model.CodeSpotlights"
                        serviceImplementation="dev.diffdino.pairing.editor.EditorCodeSpotlights"/>
        <projectService serviceImplementation="dev.diffdino.pairing.editor.PairingEditorService"/>
        <actionPromoter implementation="dev.diffdino.pairing.editor.DraftActionPromoter"/>
    </extensions>

    <actions>
        <action id="DiffDino.AcceptDraftAndNext" class="dev.diffdino.pairing.editor.actions.AcceptDraftAndNextAction"
                text="DiffDino: Accept Draft and Next" description="Take the agent's draft for this stop and go on to the next stop">
            <keyboard-shortcut keymap="$default" first-keystroke="control ENTER"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta ENTER"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta ENTER"/>
        </action>
        <action id="DiffDino.AcceptDraft" class="dev.diffdino.pairing.editor.actions.AcceptDraftAction"
                text="DiffDino: Accept Draft" description="Take the agent's draft for this stop into the file">
            <keyboard-shortcut keymap="$default" first-keystroke="control shift ENTER"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift ENTER"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift ENTER"/>
        </action>
        <action id="DiffDino.NextStop" class="dev.diffdino.pairing.editor.actions.NextStopAction"
                text="DiffDino: Next Stop" description="Leave the agent's draft and go on to the next stop">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt ENTER"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt ENTER"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt ENTER"/>
        </action>
        <group id="DiffDino.Agent" text="DiffDino" popup="true">
            <action id="DiffDino.OpenAgentChat"
                    class="dev.diffdino.pairing.ui.action.OpenAgentChatAction"
                    text="DiffDino: Open Agent Chat"
                    description="Open the DiffDino agent chat, or start one"/>
            <action id="DiffDino.StartPairingSession"
                    class="dev.diffdino.pairing.ui.action.StartPairingSessionAction"
                    text="DiffDino: Start Pairing Session..."
                    description="Describe a change and have the agent take you through it one place at a time"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
        <action id="DiffDino.SendSelectionToAgent"
                class="dev.diffdino.pairing.ui.action.SendSelectionToAgentAction"
                text="Send Selection to DiffDino Agent"
                description="Ask the DiffDino agent about the selected code">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
